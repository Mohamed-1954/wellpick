---
// The hero's focal object: the three product screens stacked as layers of one
// client workflow. The DOM version (CSS 3D) is the complete, accessible poster
// and the only version on phones, under reduced motion, or without WebGL.
// On capable desktops, stack3d.ts replaces the painting with a Three.js scene
// of the same screens (same images, same order) and keeps this DOM for alt text.
import { vendorImage } from '../lib/media';

const layers = [
  {
    chapter: 'fillout',
    step: '01',
    job: 'Collect the brief',
    tool: 'Fillout',
    name: 'fillout-designer.png',
    alt: 'Fillout form designer: a branded intake form with a theme panel for colors and fields',
  },
  {
    chapter: 'softr',
    step: '02',
    job: 'Show the client their work',
    tool: 'Softr',
    name: 'softr-portal.webp',
    alt: "Softr's published client portal demo: projects with status labels and a table of recent invoices",
  },
  {
    chapter: 'noloco',
    step: '03',
    job: 'Run the team behind it',
    tool: 'Noloco',
    name: 'noloco-crm-canvas.png',
    alt: 'Noloco deal pipeline: kanban columns of client deals with pipeline totals above',
  },
].map((l) => ({ ...l, img: vendorImage(l.name) }));

const textures = layers.map((l) => ({
  src: l.img.src.replace(/-(640|1200)\.webp$/, '-1200.webp'),
  w: l.img.width,
  h: l.img.height,
  chapter: l.chapter,
}));
---

<div class="stack" data-stack3d data-textures={JSON.stringify(textures)}>
  <div class="stack-stage">
    <div class="stack-poster">
      {
        layers.map((l, i) => (
          <figure class="layer" data-chapter={l.chapter} data-layer={i}>
            <div class="layer-slab">
              <img
                src={l.img.src}
                srcset={l.img.srcset}
                sizes="(min-width: 64rem) 34rem, 80vw"
                width={l.img.width}
                height={l.img.height}
                alt={l.alt}
                loading={i === 1 ? 'eager' : 'lazy'}
                fetchpriority={i === 1 ? 'high' : undefined}
                decoding="async"
              />
            </div>
          </figure>
        ))
      }
    </div>
  </div>

  <ol class="stack-legend">
    {
      layers.map((l, i) => (
        <li data-chapter={l.chapter}>
          <a href={`/${l.chapter}/`} data-layer-link={i}>
            <span class="legend-step num">{l.step}</span>
            <span class="legend-text">
              <span class="legend-job">{l.job}</span>
              <span class="legend-tool">{l.tool}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</div>

<script>
  import { initHeroStack } from '../scripts/hero-stack';
  initHeroStack();
</script>

<style>
  .stack {
    position: relative;
    display: grid;
    gap: var(--s-6);
  }
  .stack-stage {
    position: relative;
    aspect-ratio: 1.12;
    width: 100%;
    perspective: 1800px;
    perspective-origin: 60% 20%;
  }
  /* The WebGL canvas bleeds well past the stage so slabs can tilt, spread and
     lift without meeting a hard edge. The scene is framed against the stage
     height (stack3d.ts widens the lens by the same factor), so the extra width
     only adds room at the sides. The canvas never takes pointer input, so the
     overlap never blocks the copy beside it; `.hero` clips it at the viewport. */
  .stack-stage :global(canvas) {
    position: absolute;
    inset: -18% -28%;
    width: 156% !important;
    height: 136% !important;
    max-width: none;
    pointer-events: none;
    opacity: 0;
    transition: opacity 700ms var(--ease-out);
  }
  .stack.is-webgl .stack-stage :global(canvas) { opacity: 1; }
  /* One stack at a time. While the scene loads and once it runs, the poster is
     not painted (it stays in the DOM for its alt text). No crossfade: the two
     stacks are framed differently, and fading one over the other showed as a
     ghost duplicate beneath the canvas. */
  .stack.is-webgl .stack-poster,
  .stack.is-loading-3d .stack-poster { opacity: 0; }

  .stack-poster {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: rotateX(22deg) rotateY(-24deg) rotateZ(4deg);
  }
  .layer {
    --lift: 0rem;
    position: absolute;
    left: 6%;
    width: 72%;
    margin: 0;
    transform-style: preserve-3d;
    transition: transform var(--t-slow) var(--ease-out), filter var(--t-med) var(--ease-out);
  }
  .layer[data-layer='0'] { top: 44%; transform: translate3d(-4%, 0, 0) translateZ(var(--lift)); }
  .layer[data-layer='1'] { top: 22%; left: 16%; transform: translate3d(0, 0, 60px) translateZ(var(--lift)); }
  .layer[data-layer='2'] { top: 0%; left: 26%; transform: translate3d(4%, 0, 120px) translateZ(var(--lift)); }
  .layer-slab {
    padding: 1.6%;
    border-radius: 14px;
    background: var(--ch);
    box-shadow:
      0 1px 0 oklch(1 0 0 / 0.25) inset,
      0 30px 60px -30px oklch(0.15 0.03 262 / 0.55),
      0 8px 16px -8px oklch(0.15 0.03 262 / 0.35);
  }
  .layer img {
    width: 100%;
    border-radius: 11px;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top left;
    background: oklch(0.97 0.004 262);
  }
  .stack.is-focus .layer { filter: saturate(0.6) brightness(0.9); }
  .stack.is-focus .layer.is-active { filter: none; --lift: 70px; }

  /* Legend: a three-step index, not three cards. Each step opens with a rule
     in its tool's color; hovering or focusing a step lifts that layer. */
  .stack-legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-4);
  }
  .stack-legend a {
    display: flex;
    gap: 0.6rem;
    height: 100%;
    padding: 0.75rem 0 0.25rem;
    border-top: 2px solid var(--ch);
    text-decoration: none;
  }
  .legend-step { font-weight: 700; color: var(--muted); font-size: 0.8125rem; padding-top: 0.1rem; }
  .legend-text { display: grid; gap: 0.2rem; }
  .legend-job { font-size: 0.9375rem; font-weight: 640; line-height: 1.25; text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 0.2em; transition: text-decoration-color var(--t-fast) var(--ease-out); }
  .stack-legend a:hover .legend-job,
  .stack-legend a:focus-visible .legend-job { text-decoration-color: currentColor; }
  .legend-tool { font-size: 0.8125rem; color: var(--muted); }

  @media (max-width: 40rem) {
    /* The tilted poster paints past its box as it turns on scroll; the legend
       keeps clear of it. */
    .stack { gap: var(--s-8); }
    .stack-legend { grid-template-columns: 1fr; gap: 0; }
    .stack-legend a { align-items: baseline; padding-block: 0.8rem; border-top-width: 1px; border-top-color: var(--line); }
    .stack-legend li:first-child a { border-top: 2px solid var(--ink); }
    .legend-text { grid-template-columns: 1fr auto; align-items: baseline; width: 100%; }
  }
</style>
