---
// A product named in running meta: its 8px chapter swatch, then the name.
// No pill, no border; as a link it underlines in the product's color on hover.
import { getProduct, type ProductId } from '../lib/site';

interface Props {
  product: ProductId;
  showRole?: boolean;
  /** Render as a link to the product hub */
  link?: boolean;
}
const { product, showRole = false, link = false } = Astro.props;
const p = await getProduct(product);
const Tag = link ? 'a' : 'span';
---

<Tag class="product-tag" data-chapter={product} href={link ? `/${product}/` : undefined}>
  <span class="chip-dot" aria-hidden="true"></span>
  <span class="pt-name">{p.name}</span>{showRole && <span class="role">{p.role}</span>}
</Tag>

<style>
  .product-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 1.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
    text-decoration: none;
  }
  .pt-name {
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.22em;
    text-decoration-color: transparent;
    transition: text-decoration-color var(--t-fast) var(--ease-out);
  }
  span.product-tag .pt-name { text-decoration: none; }
  a.product-tag:hover .pt-name { text-decoration-color: var(--ch); }
  .role { color: var(--muted); font-weight: 500; }
  .role::before { content: '·'; margin-right: 0.4em; }
</style>
