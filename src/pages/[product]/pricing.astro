---
import ProductHubLayout from '../../layouts/ProductHubLayout.astro';
import { breadcrumbSchema } from '../../lib/breadcrumbSchema';
import PlanLadder from '../../components/PlanLadder.astro';
import FactList from '../../components/FactList.astro';
import OfficialCta from '../../components/OfficialCta.astro';
import NextSteps from '../../components/NextSteps.astro';
import Sources from '../../components/Sources.astro';
import { PRODUCT_IDS, getProduct, type ProductId } from '../../lib/site';
import { HUBS } from '../../data/hubs';
import { getPricing } from '../../lib/pricing';
import { fitSoftr, fitNoloco, fitFillout, type Needs, type Fit } from '../../lib/stackPlan';

export function getStaticPaths() {
  return PRODUCT_IDS.map((product) => ({ params: { product } }));
}
const { product } = Astro.params as { product: ProductId };
const hub = HUBS[product];
const p = await getProduct(product);
const { plans, statement, sources } = await getPricing(product);
const paid = plans.filter((x) => (x.yearlyMonthly ?? 0) > 0);
const sourceIds = [...new Set([...sources.map((s) => s.id), ...hub.billFacts.map((f) => f.source)])];

// Worked examples: the same fit logic as the plan finder, run on fixed situations.
const base: Needs = {
  staff: 1, builders: 1, staffFreeEmail: 0, clients: 0, records: 3000, externalData: true,
  granularRoles: false, writeRestrictions: false, fillout: false, responses: 0,
  largestFileMb: 5, loginForm: false, duplicatePrevention: false,
};
const people: { who: string; needs: Partial<Needs> }[] = [
  { who: 'You plus 4 client contacts, records in Airtable', needs: { clients: 4 } },
  { who: '3 staff, 5 client contacts', needs: { staff: 3, clients: 5 } },
  { who: '3 staff, 6 client contacts', needs: { staff: 3, clients: 6 } },
  { who: '3 staff (one on Gmail), 5 client contacts', needs: { staff: 3, staffFreeEmail: 1, clients: 5 } },
  { who: '3 staff, 30 clients, data in the app’s own tables', needs: { staff: 3, clients: 30, externalData: false, records: 1500 } },
  { who: '3 staff, 20 clients who edit their own records', needs: { staff: 3, clients: 20, writeRestrictions: true, granularRoles: true } },
  { who: '8 staff, 80 client contacts', needs: { staff: 8, clients: 80 } },
  { who: '15 staff (2 builders), 300 client contacts', needs: { staff: 15, builders: 2, clients: 300 } },
];
const intake: { who: string; needs: Partial<Needs> }[] = [
  { who: '200 briefs a month, small attachments', needs: { responses: 200 } },
  { who: '1,500 responses a month', needs: { responses: 1500 } },
  { who: 'Clients sign in before updating their brief', needs: { responses: 200, loginForm: true } },
  { who: '4,000 responses a month', needs: { responses: 4000 } },
  { who: 'Clients upload 200 MB video files', needs: { responses: 100, largestFileMb: 200 } },
  { who: 'Airtable must block duplicate contacts', needs: { responses: 300, duplicatePrevention: true } },
];
const fit = (needs: Needs): Fit =>
  product === 'softr' ? fitSoftr(plans, needs) : product === 'noloco' ? fitNoloco(plans, needs) : fitFillout(plans, needs);
// Notes about the shared Airtable assumption would repeat on every row; the table note states them once.
const examples = (product === 'fillout' ? intake : people).map((s) => {
  const f = fit({ ...base, ...s.needs });
  return { who: s.who, fit: { ...f, notes: f.notes.filter((t) => !t.startsWith('Softr record caps') && !t.startsWith('External sources such as Airtable')) } };
});
const price = (v: number | null) => (v === null ? 'Custom' : `$${v.toLocaleString('en-US')}`);
// The published pricing statement, one clause per line instead of one paragraph.
const recorded = statement
  .split(/;\s+|\.\s+(?=[A-Z])/)
  .map((s) => s.trim().replace(/\.$/, ''))
  .map((s) => s.charAt(0).toUpperCase() + s.slice(1))
  .filter(Boolean);

const jsonLd = breadcrumbSchema([
  { label: 'Home', href: '/' },
  { label: p.name, href: `/${product}/` },
  { label: 'Pricing' },
], Astro.site ?? Astro.url);
---

<ProductHubLayout
  product={product}
  title={`${p.name} pricing: plans and limits`}
  description={`${p.name} pricing for small service businesses: every plan on both billing bases, worked cost examples, and the limits that change the bill.`}
  headline={`${p.name} pricing, plan by plan.`}
  lead="Every published plan on both billing bases, what typical setups actually cost, and the limits that matter more than the headline price."
  secondary={{ href: `/${product}/`, label: `Read the ${p.name} guide` }}
  isPricing
  jsonLd={jsonLd}
>
  <section class="section" aria-labelledby="ladder-title">
    <div class="shell">
      <div class="pp-head">
        <h2 id="ladder-title">Every plan, one decision each.</h2>
        <p class="lead">{hub.planNote}</p>
      </div>
      <PlanLadder product={product} specs={hub.specs} picks={hub.picks} />
    </div>
  </section>

  <section class="section" aria-labelledby="examples-title">
    <div class="shell">
      <div class="pp-head">
        <h2 id="examples-title">What you would pay, worked out.</h2>
        <p class="lead">
          {product === 'fillout'
            ? 'Fillout prices by responses and features, not seats. Each row is the first plan that covers the situation.'
            : `${p.name} prices by who logs in. Each row is the first plan that fits, with the add-ons it needs.`}
          {' '}The same rules run the <a class="text-link" href="/guides/portal-costs/">plan finder</a>, so you can enter your own numbers.
        </p>
      </div>
      <div class="table-scroll pp-table pp-wide" role="region" aria-label={`${p.name} cost in example situations`} tabindex="0">
        <table class="data-table" data-stack role="table">
          <caption>{p.name} list prices, USD per month</caption>
          <thead role="rowgroup">
            <tr role="row"><th scope="col" role="columnheader">Situation</th><th scope="col" role="columnheader">First plan that fits</th><th scope="col" role="columnheader">Billed yearly</th><th scope="col" role="columnheader">Billed monthly</th><th scope="col" role="columnheader">Why</th></tr>
          </thead>
          <tbody role="rowgroup">
            {
              examples.map((e) => (
                <tr role="row">
                  <th scope="row" role="rowheader">{e.who}</th>
                  <td role="cell" data-label="First plan" class="pp-plan">{e.fit.plan ?? 'Enterprise'}</td>
                  <td role="cell" data-label="Billed yearly" class="pp-price">{price(e.fit.yearly)}</td>
                  <td role="cell" data-label="Billed monthly" class="pp-price">{price(e.fit.monthly)}</td>
                  <td role="cell" data-label="Why">{e.fit.notes.join(' ') || 'Within the plan’s included allowance.'}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      {product !== 'fillout' && <p class="pp-note">Assumes records stay in Airtable unless stated, fewer than 25,000 records and one builder unless stated. “Clients” means people who log in, not client companies.{product === 'softr' ? ' Softr’s record caps apply to Softr Databases; with an external source, ask Softr which limit applies.' : ' An Airtable or other external source needs Build; Free runs on Noloco’s own tables only.'}</p>}
    </div>
  </section>

  <section class="section" aria-labelledby="annual-title">
    <div class="shell">
      <div class="pp-head">
        <h2 id="annual-title">Yearly vs monthly billing.</h2>
        <p class="lead">Each paid plan on both billing bases, and what paying for the year saves.</p>
      </div>
      <div class="pp-annual-grid">
        <div class="table-scroll pp-table" role="region" aria-label={`${p.name} yearly and monthly prices`} tabindex="0">
          <table class="data-table" data-stack role="table">
            <thead role="rowgroup">
              <tr role="row"><th scope="col" role="columnheader">Plan</th><th scope="col" role="columnheader" class="pp-price">Billed yearly, per month</th><th scope="col" role="columnheader" class="pp-price">Billed monthly</th><th scope="col" role="columnheader" class="pp-price">Yearly saving</th></tr>
            </thead>
            <tbody role="rowgroup">
              {
                paid.map((x) => (
                  <tr role="row">
                    <th scope="row" role="rowheader">{x.name}</th>
                    <td role="cell" data-label="Yearly, per month" class="pp-price">${x.yearlyMonthly}</td>
                    <td role="cell" data-label="Billed monthly" class="pp-price">{x.monthly != null ? `$${x.monthly}` : 'n/a'}</td>
                    <td role="cell" data-label="Yearly saving" class="pp-price">{x.monthly != null && x.yearlyMonthly != null ? `$${(x.monthly - x.yearlyMonthly) * 12} a year` : 'n/a'}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <aside class="pp-recorded" aria-labelledby="recorded-title">
          <h3 id="recorded-title">The published price list</h3>
          <ul>
            {recorded.map((line) => <li>{line}</li>)}
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="bill-title">
    <div class="shell pp-split">
      <div>
        <h2 id="bill-title">What changes the bill.</h2>
        <p class="lead">
          The plan price is rarely the whole cost. Seats, records, responses, connected services and the
          person who maintains the app sit on the same bill.
        </p>
        <p class="pp-link"><a class="text-link" href="/guides/portal-costs/">Price your own setup in the plan finder</a></p>
      </div>
      <FactList items={hub.billFacts} large />
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="pp-end">
        <p class="pp-end-line">Pick the plan here. <span class="tone-2">Buy it on {p.name}’s own pricing page.</span></p>
        <OfficialCta product={product} to="pricing" label={`Open ${p.name}’s pricing page`} placement="pricing-end" />
      </div>
      <NextSteps
        items={[
          { to: `/${product}/`, title: `The ${p.name} guide`, product },
          { to: '/guides/portal-costs/', title: 'What the whole stack costs' },
          product === 'fillout'
            ? { to: '/compare/fillout-vs-tally/', title: 'Is free Tally enough instead?' }
            : { to: '/compare/softr-vs-noloco/', title: 'Softr vs Noloco at six team sizes' },
        ]}
      />
      <Sources ids={sourceIds} />
    </div>
  </section>
</ProductHubLayout>

<style>
  /* Section heads: the H2, then one line, then the content. */
  .pp-head { display: grid; gap: var(--s-3); margin-bottom: var(--s-7); }
  .pp-head .lead { max-width: 60ch; }
  .pp-wide { max-width: none; }
  .pp-wide table { min-width: 46rem; }
  @media (max-width: 40rem) { .pp-wide table { min-width: 0; } }
  /* Phones: plan and prices share one line under the situation; the reason
     runs full width below them. */
  @media (max-width: 40rem) {
    .pp-table table[data-stack] > tbody > tr { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--s-4); }
    .pp-table table[data-stack] > tbody > tr > th,
    .pp-table table[data-stack] > tbody > tr > td:nth-child(5) { grid-column: 1 / -1; }
  }
  .pp-plan { font-weight: 650; color: var(--ink); }
  .pp-price { white-space: nowrap; color: var(--ink); }
  .pp-note { margin-top: var(--s-4); font-size: 0.875rem; color: var(--muted); max-width: 80ch; }
  /* The billing table and the published price list sit side by side on wide
     screens, both opened by the same ink rule; phones stack them. */
  .pp-annual-grid { display: grid; gap: var(--s-7); align-items: start; }
  @media (min-width: 64rem) {
    .pp-annual-grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--s-5); }
    .pp-annual-grid > .pp-table { grid-column: 1 / span 7; }
    .pp-annual-grid > .pp-recorded { grid-column: 9 / -1; }
  }
  .pp-recorded { border-top: 2px solid var(--ink); }
  .pp-recorded h3 {
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--line-strong);
    font-size: 0.875rem;
    font-weight: 650;
    line-height: 1.3;
    letter-spacing: 0;
    color: var(--muted);
  }
  .pp-recorded ul {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  .pp-recorded li { padding-block: 0.75rem; border-bottom: 1px solid var(--line); }
  .pp-split { display: grid; gap: var(--s-6); }
  @media (min-width: 64rem) { .pp-split { grid-template-columns: 1fr 1.4fr; gap: var(--s-8); } .pp-split > div:first-child { position: sticky; top: 7rem; align-self: start; } }
  .pp-split .lead { margin-top: var(--s-4); }
  .pp-link { margin-top: var(--s-4); }
  /* Closing row on the canvas: a two-tone line and the one outbound action. */
  .pp-end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5) var(--s-7);
    padding-top: var(--s-6);
    border-top: 1px solid var(--line);
    margin-bottom: var(--s-8);
  }
  .pp-end-line {
    flex: 1 1 22rem;
    max-width: 28ch;
    font-size: var(--step-3);
    font-weight: var(--display-wght);
    font-variation-settings: "wdth" var(--display-wdth);
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--ink);
    text-wrap: balance;
  }
</style>
