  }
  .screen-card a:hover .screen-media img { transform: translate(-0.5rem, -0.5rem); }
  .screen-title { font-size: 1.125rem; font-weight: 680; line-height: 1.3; letter-spacing: -0.01em; text-wrap: balance; }
  .screen-card a:hover .screen-title { text-decoration: underline; text-underline-offset: 0.2em; text-decoration-thickness: 1.5px; }
  .screen-tool { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.875rem; font-weight: 560; color: var(--muted); }
  .screens-progress { position: relative; height: 2px; margin-top: var(--s-5); background: var(--line); overflow: hidden; }
  .screens-progress span {
