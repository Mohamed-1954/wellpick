  /* ---------- Screens ----------
     A full-bleed horizontal scroller with edge peek (Airtable's "High-impact
     workflows" row): the first card lines up with the shell, the last ones
     run off the right edge. Each card: a vendor screen on its chapter wash,
     bleeding off the tile's bottom right, then the job and the tool. */
  .screens { overflow-x: clip; }
  .screens-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: var(--s-5); margin-bottom: 2.5rem; }
  .screens-head .section-head { margin-bottom: 0; }
  .screens-controls { display: flex; gap: var(--s-2); }
  .icon-round {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    transition: background-color var(--t-fast) var(--ease-out), color var(--t-fast) var(--ease-out), border-color var(--t-fast) var(--ease-out);
  }
  .icon-round:hover:not(:disabled) { background: var(--ink); color: var(--on-ink); border-color: var(--ink); }
  .icon-round:disabled { opacity: 0.4; cursor: default; }
  .screens-track {
    --inset: max(var(--gutter), calc((100% - var(--max)) / 2 + var(--gutter)));
