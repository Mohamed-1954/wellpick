  .total-note { font-size: 0.9375rem; color: var(--ink-2); }

  .cost-rows { grid-column: 1 / -1; list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .cost-rows li + li { border-top: 1px solid var(--line); }
  .cost-rows a {
