    transform: translateX(calc(var(--at, 0) * (1 / var(--size, 0.35) - 1) * 100%));
  }
  /* ---------- Cost ----------
     One hairline frame on the canvas: the two stack totals as joined columns,
     the three plans that make them up as ruled rows beneath. */
  .cost-frame {
    --pad: clamp(1.25rem, 0.9rem + 1.8vw, 2.5rem);
