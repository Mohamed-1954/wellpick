  .cb-rule { width: 1px; height: 1.125rem; background: color-mix(in oklab, var(--on-chapter) 40%, transparent); }
  .cb-tool { font-weight: 560; color: var(--on-chapter-muted); }
  @media (min-width: 64rem) { .chapter-badge { display: none; } }
  @media (max-width: 63.99rem) { .chapter-tool { display: none; } }

  .chapter-title {
    font-size: var(--step-4);
    font-weight: var(--display-wght);
    font-variation-settings: "wdth" var(--display-wdth);
