---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroStack from '../components/HeroStack.astro';
import Scene from '../components/Scene.astro';
import FactList from '../components/FactList.astro';
import OfficialCta from '../components/OfficialCta.astro';
import CompareList from '../components/CompareList.astro';
import Icon from '../components/Icon.astro';
import Glyph from '../components/Glyph.astro';
import { getPricing } from '../lib/pricing';
import { vendorImage } from '../lib/media';
import { SITE } from '../lib/site';

const [softr, noloco, fillout] = await Promise.all([getPricing('softr'), getPricing('noloco'), getPricing('fillout')]);
const plan = (p: typeof softr, name: string) => {
  const found = p.plans.find((x) => x.name === name);
  if (!found) throw new Error(`Plan ${name} missing`);
  return found;
};
const filloutStarter = plan(fillout, 'Starter');
const softrBasic = plan(softr, 'Basic');
const nolocoBuild = plan(noloco, 'Build');
const annual = (...ps: { yearlyMonthly: number | null }[]) => ps.reduce((s, p) => s + (p.yearlyMonthly ?? 0), 0);
const monthly = (...ps: { monthly: number | null }[]) => ps.reduce((s, p) => s + (p.monthly ?? 0), 0);
const stackA = { annual: annual(filloutStarter, softrBasic), monthly: monthly(filloutStarter, softrBasic) };
const stackB = { annual: annual(filloutStarter, nolocoBuild), monthly: monthly(filloutStarter, nolocoBuild) };

const articles = await getCollection('articles', (a) => !a.data.draft);
const guides = articles.filter((a) => a.data.type === 'guide' && a.data.stage);
const stages = [
  { id: 'decide', title: 'Decide', blurb: 'Before you pay for anything.' },
  { id: 'build', title: 'Build', blurb: 'From records to a working portal.' },
  { id: 'launch', title: 'Launch', blurb: 'Before the first client logs in.' },
] as const;
const byStage = (id: string) =>
  guides.filter((g) => g.data.stage === id).sort((a, b) => a.data.order - b.data.order);
const comparisons = articles.filter((a) => a.data.type === 'comparison').sort((a, b) => a.data.order - b.data.order);

// Real vendor product images, one job each, for the horizontal screen
// scroller (after Airtable's "High-impact workflows" row). Titles say what
// the screen shows; they make no claim the linked guide does not support.
const screens = [
  { chapter: 'fillout', tool: 'Fillout', href: '/fillout/', name: 'fillout-builder-card.png', title: 'Build the intake form by dragging questions in', alt: 'Fillout form builder: a Short answer field dragged into a registration form' },
  { chapter: 'fillout', tool: 'Fillout', href: '/fillout/', name: 'fillout-login-card.png', title: 'Put a form behind a login page', alt: 'A Fillout form behind a "Sign in to access" page with email and password fields' },
  { chapter: 'fillout', tool: 'Fillout', href: '/guides/fillout-intake-to-airtable/', name: 'fillout-workflow-run.png', title: 'Watch each submission run its steps', alt: 'Fillout workflow run log: form submitted, AI action, send email, each with a time' },
  { chapter: 'softr', tool: 'Softr', href: '/softr/', name: 'softr-uc-onboarding.webp', title: "A new client's first form, inside the portal", alt: 'Softr portal page asking a new client for their name, business and contact method' },
  { chapter: 'softr', tool: 'Softr', href: '/softr/', name: 'softr-uc-billing.webp', title: 'Invoices the client can see and pay', alt: 'Softr portal invoices table with amounts, due dates, statuses and Pay buttons' },
  { chapter: 'softr', tool: 'Softr', href: '/softr/', name: 'softr-uc-documents.webp', title: 'Files shared with one client', alt: 'Softr portal file list with contracts and deliverables, each with edit and delete actions' },
  { chapter: 'noloco', tool: 'Noloco', href: '/noloco/', name: 'noloco-permissions.png', title: 'Roles decide who reads, edits and creates', alt: "Noloco's roles table with read, edit and create switches for each role", position: '0% 0%' },
  { chapter: 'noloco', tool: 'Noloco', href: '/noloco/', name: 'noloco-invite.png', title: 'Invite a client without team access', alt: 'Noloco invite form: the client role, restricted by data permissions, cannot modify the app' },
  { chapter: 'noloco', tool: 'Noloco', href: '/noloco/', name: 'noloco-overview.png', title: 'The team dashboard on the same records', alt: 'Noloco revenue dashboard with billables, collected revenue and hours per employee', position: '30% 0%' },
].map((s) => ({ ...s, img: vendorImage(s.name) }));

const chapters = [
  {
    id: 'fillout',
    n: '01',
    tab: 'Intake',
    title: 'Collect a brief you can actually work from.',
    tool: 'Fillout',
    price: `From $${filloutStarter.yearlyMonthly}/mo`,
    now: 'Answers land as records in your base.',
    scene: {
      layout: 'bleed' as const,
      style: '--scene-ratio: 16 / 8; --my: 9%; --mw: 104%; --fx: auto; --fr: 4%; --fy: 0%; --fb: auto; --fw: 36%;',
      main: { name: 'fillout-airtable-form.png', alt: "Fillout's lead form sending its answers to a new row in an Airtable base" },
      float: { name: 'fillout-login-card.png', alt: 'A Fillout form behind a "Sign in to access" login page' },
    },
    facts: [
      { text: 'Questions can show or hide based on earlier answers, URL parameters, integration data or dates, on every plan.', source: 'filloutLogic' },
      { text: 'A form can create an Airtable record, or update one through a per-record link. That link exposes the whole record unless you restrict prefilled data.', source: 'filloutUpdate' },
      { text: 'Login pages start on Starter. A prefilled email is context, not proof of identity.', source: 'filloutLogin' },
    ],
  },
  {
    id: 'softr',
    n: '02',
    tab: 'Portal',
    title: 'Give clients a page with their work on it.',
    tool: 'Softr',
    price: `From $${softrBasic.yearlyMonthly}/mo`,
    now: 'The same records, shown to each client.',
    scene: {
      layout: 'bleed' as const,
      style: '--scene-ratio: 16 / 8.4; --my: 9%; --mx: 9%; --mw: 104%; --fw: 32%; --fy: 30%; --fb: auto; --fx: 2.5%;',
      main: {
        name: 'softr-ai-builder-poster.jpg',
        video: 'softr-ai-builder.mp4',
        alt: "Softr's own recording: its AI builder sets up a partner portal's sign-in, tables and home page",
      },
      float: { name: 'softr-uc-billing.webp', alt: 'A Softr client portal page listing invoices, each with a Pay button', ratio: '1 / 0.8' },
    },
    facts: [
      { text: 'Builds list and detail pages over Airtable, Google Sheets or its own database, with user groups for each client.', source: 'softrPortal' },
      { text: 'View restrictions work on every plan. Create, edit and delete restrictions need Business.', source: 'softrRestrictions' },
      { text: 'Basic covers 5 team and 5 client users with no add-ons. The sixth client login means Pro.', source: 'softrPlansDocs' },
    ],
  },
  {
    id: 'noloco',
    n: '03',
    tab: 'Team',
    title: 'Run the portal and the team on the same records.',
    tool: 'Noloco',
    price: `From $${nolocoBuild.yearlyMonthly}/mo`,
    now: 'The same records run the team.',
    scene: {
      layout: 'angle' as const,
      style: '--scene-ratio: 16 / 8.6; --mx: 14%; --my: 10%; --mw: 98%; --rx: 16deg; --ry: -20deg; --rz: 5deg; --fx: 2.5%; --fy: 26%; --fb: auto; --fw: 42%;',
      main: { name: 'noloco-project-canvas.png', alt: 'Noloco project tracker with campaign budgets, progress and owners' },
      float: { name: 'noloco-permissions.png', alt: "Noloco's roles table with read, edit and create switches for each role" },
    },
    facts: [
      { text: 'Only permissions are enforced on the server. Visibility rules and filters shape the screen, not access.', source: 'nolocoAccess' },
      { text: 'Roles add up: a second role can widen access, never narrow it.', source: 'nolocoRoles' },
      { text: 'Build includes 10 team seats and 1,000 active clients. A seat counts once someone logs in.', source: 'nolocoPricingGuide' },
    ],
  },
];

const problems = [
  { chapter: 'fillout', quote: 'Briefs arrive half empty, and work starts on guesses.', fix: 'Fix intake first', tool: 'Fillout' },
  { chapter: 'softr', quote: 'Clients keep emailing to ask where their project stands.', fix: 'Give them a portal', tool: 'Softr' },
  { chapter: 'noloco', quote: 'My team and my clients work from different spreadsheets.', fix: 'Share one set of records', tool: 'Noloco' },
];

const faqs = [
  {
    q: 'Do I need a client portal at all?',
    a: 'Not always. A portal pays off when clients repeatedly need the same project information or need to act on it. If a shared folder and a weekly update solve the problem, keep the simpler system.',
    link: { href: '/start/', label: 'Take the two-minute decision guide' },
  },
  {
    q: 'Why not rank the three tools?',
    a: 'They do different jobs. Fillout is intake. Softr and Noloco are portal candidates, and Noloco also runs internal operations. A single score would hide the decision you actually face.',
  },
  {
    q: 'Can I try the stack before paying?',
    a: 'Yes. Fillout Free takes 1,000 responses a month, Softr Free covers 5 app users, and Noloco Free covers 50 active clients, with a 14-day Build trial and no card. Prototype with fictional records, then pay for the plan your real users need.',
    link: { href: '/guides/portal-costs/', label: 'Cost your whole stack' },
  },
];

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: new URL('/', Astro.site ?? Astro.url).href },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<BaseLayout
  title="Intake, portals and team tools, priced"
  description="Independent guides to Fillout, Softr and Noloco for small service businesses: what each tool does, what it costs, and when to buy nothing."
  jsonLd={jsonLd}
  closing
>
  <!-- Hero -->
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <h1 class="hero-title" data-split="now">Better briefs.<br /> Clearer portals.<br /> Calmer teams.</h1>
        <p class="lead hero-lead" data-reveal style="--rd: 650ms">
          Independent picks for client work: Fillout for the brief, Softr for the portal, Noloco for the team.
          Real prices, real limits, and a straight answer when you need none of them.
        </p>
        <div class="hero-actions" data-reveal style="--rd: 820ms">
          <a class="btn" href="/start/">Find your stack <Icon name="arrow-right-linear" class="btn-icon" /></a>
          <a class="text-link" href="#cost">See what it costs</a>
        </div>
      </div>
      <div class="hero-visual" data-reveal="media" style="--rd: 250ms">
        <HeroStack />
      </div>
    </div>
  </section>

  <!-- Problems -->
  <section class="problems section" aria-labelledby="problems-title">
    <div class="shell">
      <div class="section-head">
        <h2 id="problems-title">Start with the job that is broken.</h2>
        <p class="lead">Pick the sentence that sounds like your week. That is the tool to read about first.</p>
      </div>
      <ol class="problem-list">
        {
          problems.map((p) => (
            <li data-chapter={p.chapter}>
              <a href={`/${p.chapter}/`}>
                <span class="pl-quote">“{p.quote}”</span>
                <span class="pl-fix">
                  {p.fix}
                  <span class="pl-tool">
                    <span class="chip-dot" aria-hidden="true" />
                    {p.tool}
                  </span>
                </span>
                <Icon name="arrow-right-linear" class="pl-arrow" size="1.5rem" />
              </a>
            </li>
          ))
        }
      </ol>
      <p class="problems-foot">
        Two tools could do the portal job. <a class="text-link" href="/compare/softr-vs-noloco/">Compare Softr and Noloco on the same client work</a>
      </p>
    </div>
  </section>

  <!-- Chapters -->
  <section class="chapters" aria-labelledby="chapters-title">
    <div class="shell chapters-grid">
      <div class="chapters-rail">
        <h2 id="chapters-title" class="rail-title">Three jobs, <span class="tone-2">three tools.</span></h2>
        <ol class="rail-tabs" aria-label="Chapters">
          {
            chapters.map((c, i) => (
              <li data-chapter={c.id} style={`--i: ${i}`}>
                <a href={`#chapter-${c.id}`} data-chapter-tab={i} aria-current={i === 0 ? 'true' : undefined}>
                  <Glyph name={({ fillout: 'intake', softr: 'portal', noloco: 'team' } as const)[c.id as 'fillout']} tone="canvas" size="2.5rem" class="rail-glyph" />
                  <span class="rail-n num">{c.n}</span>
                  <span class="rail-tab">{c.tab}</span>
                  <span class="rail-tool">{c.tool}</span>
                  <span class="rail-bar" aria-hidden="true"><span></span></span>
                </a>
              </li>
            ))
          }
        </ol>
        <div class="rail-now" aria-hidden="true">
          {
            chapters.map((c, i) => (
              <p class="rail-now-item" data-chapter={c.id} data-rail-now={i} data-active={i === 0 ? '' : undefined}>
                <span class="rn-tool">{c.tool}</span>
                <span class="rn-line">{c.now}</span>
              </p>
            ))
          }
        </div>
      </div>
      <div class="chapter-stack">
        {
          chapters.map((c, i) => (
            <article class="chapter field" id={`chapter-${c.id}`} data-chapter={c.id} data-chapter-panel={i}>
              <header class="chapter-head">
                <p class="chapter-badge">
                  <span class="cb-n num">{c.n}</span>
                  <span class="cb-tab">{c.tab}</span>
                  <span class="cb-rule" aria-hidden="true" />
                  <span class="cb-tool">{c.tool}</span>
                </p>
                <h3 class="chapter-title">{c.title}</h3>
                <p class="chapter-meta">
                  <span class="chapter-tool">{c.tool}</span>
                  <span><span class="num">{c.price}</span> billed yearly</span>
                </p>
              </header>
              <div class="chapter-body">
                <FactList items={c.facts} />
                <div class="chapter-actions">
                  <a class="btn btn-light" href={`/${c.id}/`}>
                    Read the {c.tool} guide <Icon name="arrow-right-linear" class="btn-icon" />
                  </a>
                  <OfficialCta product={c.id as 'fillout'} to="pricing" label={`${c.tool} pricing`} placement="home-chapter" onDark ghost />
                </div>
              </div>
              <Scene
                class="chapter-scene"
                chapter={c.id as 'fillout'}
                tone="none"
                layout={c.scene.layout}
                style={c.scene.style}
                main={c.scene.main}
                float={c.scene.float}
                sizes="(min-width: 64rem) 58rem, 110vw"
                floatSizes="(min-width: 64rem) 26rem, 48vw"
              />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Screens -->
  <section class="screens section" aria-labelledby="screens-title">
    <div class="shell screens-head" data-reveal>
      <div class="section-head">
        <h2 id="screens-title">What clients and your team <span class="tone-2">would look at.</span></h2>
        <p class="lead">Screens from each vendor's own product images, one job per card.</p>
      </div>
      <div class="screens-controls">
        <button type="button" class="icon-round" data-screens-prev aria-label="Previous screens" disabled>
          <Icon name="arrow-left-linear" size="1.25rem" />
        </button>
        <button type="button" class="icon-round" data-screens-next aria-label="Next screens">
          <Icon name="arrow-right-linear" size="1.25rem" />
        </button>
      </div>
    </div>
    <ul class="screens-track" data-screens-track tabindex="0" aria-label="Product screens" data-reveal-stagger="70">
      {
        screens.map((s) => (
          <li class="screen-card" data-chapter={s.chapter} data-reveal>
            <a href={s.href}>
              <span class="screen-media field-wash">
                <img
                  src={s.img.src}
                  srcset={s.img.srcset}
                  sizes="(min-width: 64rem) 24rem, 80vw"
                  width={s.img.width}
                  height={s.img.height}
                  alt={s.alt}
                  loading="lazy"
                  decoding="async"
                  style={s.position ? `object-position: ${s.position}` : undefined}
                />
              </span>
              <span class="screen-title">{s.title}</span>
              <span class="screen-tool">
                <span class="chip-dot" aria-hidden="true" />
                {s.tool}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="shell">
      <div class="screens-progress" aria-hidden="true"><span data-screens-bar></span></div>
    </div>
  </section>

  <!-- Cost -->
  <section class="cost section" id="cost" aria-labelledby="cost-title">
    <div class="shell">
      <div class="section-head">
        <h2 id="cost-title">What the stack costs.</h2>
        <p class="lead">The cheapest published plan that covers each job, billed yearly. Monthly billing costs more.</p>
      </div>
      <div class="cost-frame">
        <div class="total">
          <p class="total-label">Fillout Starter + Softr Basic</p>
          <p class="total-figure num">${stackA.annual}<span class="per">/mo</span></p>
          <p class="total-note">${stackA.monthly}/mo on monthly billing. Up to 5 client logins.</p>
        </div>
        <div class="total">
          <p class="total-label">Fillout Starter + Noloco Build</p>
          <p class="total-figure num">${stackB.annual}<span class="per">/mo</span></p>
          <p class="total-note">${stackB.monthly}/mo on monthly billing. Up to 1,000 active clients, 10 team seats.</p>
        </div>
        <ul class="cost-rows">
          <li data-chapter="fillout">
            <a href="/fillout/pricing/">
              <span class="cr-job"><span class="chip-dot" aria-hidden="true" />Collect the brief</span>
              <span class="cr-plan">Fillout Starter · {Number(filloutStarter.responses).toLocaleString('en-US')} responses a month, login forms</span>
              <span class="cr-price num">${filloutStarter.yearlyMonthly}<span class="cr-per">/mo</span></span>
            </a>
          </li>
          <li data-chapter="softr">
            <a href="/softr/pricing/">
              <span class="cr-job"><span class="chip-dot" aria-hidden="true" />Give clients a portal</span>
              <span class="cr-plan">Softr Basic · {String(softrBasic.users)} users, no add-ons</span>
              <span class="cr-price num">${softrBasic.yearlyMonthly}<span class="cr-per">/mo</span></span>
            </a>
          </li>
          <li data-chapter="noloco">
            <a href="/noloco/pricing/">
              <span class="cr-job"><span class="chip-dot" aria-hidden="true" />Run the team behind it</span>
              <span class="cr-plan">Noloco Build · 10 team seats, {Number(nolocoBuild.records).toLocaleString('en-US')} records</span>
              <span class="cr-price num">${nolocoBuild.yearlyMonthly}<span class="cr-per">/mo</span></span>
            </a>
          </li>
        </ul>
      </div>
      <p class="cost-foot">
        Seats, records and file limits change the bill more than the headline price.{" "}
        <a class="text-link" href="/guides/portal-costs/">Cost your whole stack</a>
      </p>
    </div>
  </section>

  <!-- Compare -->
  <section class="compare section" aria-labelledby="compare-title">
    <div class="shell">
      <div class="section-head">
        <h2 id="compare-title">Compare before you commit.</h2>
        <p class="lead">Same client job, different tools. Documented differences, then a pick for each situation.</p>
      </div>
      <CompareList items={comparisons} />
    </div>
  </section>

  <!-- Guides -->
  <section class="guides section" aria-labelledby="guides-title">
    <div class="shell">
      <div class="section-head">
        <h2 id="guides-title">Guides for every step of the job.</h2>
        <p class="lead">Each guide ends with checks you can run yourself, with fictional data, before a client sees anything.</p>
      </div>
      <div class="stage-cols">
        {
          stages.map((s) => (
            <div class="stage-col">
              <h3>{s.title}</h3>
              <p class="stage-blurb">{s.blurb}</p>
              <ul>
                {byStage(s.id).map((g) => (
                  <li>
                    <a href={`/${g.id}/`}>
                      {g.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="guides-foot"><a class="btn btn-ghost" href="/guides/">All guides <Icon name="arrow-right-linear" class="btn-icon" /></a></p>
    </div>
  </section>

  <!-- Downloads -->
  <section class="downloads" aria-labelledby="downloads-title">
    <div class="shell downloads-inner">
      <div>
        <h2 id="downloads-title">Working files. No email gate.</h2>
        <p class="lead">Plain files you can adapt. No account, no form, no newsletter.</p>
      </div>
      <ul class="dl-list">
        <li>
          <a href="/resources/client-intake-brief.txt" download>
            <Icon name="document-text-linear" size="1.5rem" />
            <span><strong>Client intake brief</strong><span>Scope, decision makers, materials and the first handoff. TXT</span></span>
            <Icon name="download-minimalistic-linear" size="1.25rem" class="dl-icon" />
          </a>
        </li>
        <li>
          <a href="/resources/portal-permission-checks.csv" download>
            <Icon name="shield-check-linear" size="1.5rem" />
            <span><strong>Two-client permission log</strong><span>Expected and observed access, row by row. CSV</span></span>
            <Icon name="download-minimalistic-linear" size="1.25rem" class="dl-icon" />
          </a>
        </li>
        <li>
          <a href="/resources/portal-cost-worksheet.csv" download>
            <Icon name="calculator-linear" size="1.5rem" />
            <span><strong>Whole-stack cost worksheet</strong><span>Plans, connected services and upkeep on one basis. CSV</span></span>
            <Icon name="download-minimalistic-linear" size="1.25rem" class="dl-icon" />
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq section" aria-labelledby="faq-title">
    <div class="shell faq-grid">
      <h2 id="faq-title">Straight answers.</h2>
      <dl class="faq-list">
        {
          faqs.map((f) => (
            <div class="faq-item">
              <dt>{f.q}</dt>
              <dd>
                <p>{f.a}</p>
                {f.link && <a class="text-link" href={f.link.href}>{f.link.label}</a>}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</BaseLayout>

<script>
  // Chapter rail (after Airtable's sticky chapter column): the chapter in view
  // is current, its line crossfades in under the tabs, and the spine fills in
  // chapter colors as the panels scroll past. Progress is a CSS variable set
  // once per frame; no layout reads outside that frame.
  const tabs = [...document.querySelectorAll<HTMLAnchorElement>('[data-chapter-tab]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-chapter-panel]')];
  const lines = [...document.querySelectorAll<HTMLElement>('[data-rail-now]')];
  const rail = document.querySelector<HTMLElement>('.rail-tabs');
  const stack = document.querySelector<HTMLElement>('.chapter-stack');
  const setCurrent = (i: number) => {
    tabs.forEach((t, j) => (j === i ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')));
    lines.forEach((l, j) => l.toggleAttribute('data-active', j === i));
  };
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) if (e.isIntersecting) setCurrent(Number((e.target as HTMLElement).dataset.chapterPanel));
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  panels.forEach((p) => io.observe(p));

  if (rail && stack) {
    let queued = false;
    const update = () => {
      queued = false;
      const r = stack.getBoundingClientRect();
      const p = (window.innerHeight * 0.5 - r.top) / r.height;
      rail.style.setProperty('--p', String(Math.min(1, Math.max(0, p))));
    };
    const queue = () => {
      if (!queued) (queued = true), requestAnimationFrame(update);
    };
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue, { passive: true });
    update();
  }

  // Screen scroller: native horizontal scroll with snap; the arrows move one
  // card width, the bar under it shows the position.
  const track = document.querySelector<HTMLElement>('[data-screens-track]');
  const prev = document.querySelector<HTMLButtonElement>('[data-screens-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-screens-next]');
  const bar = document.querySelector<HTMLElement>('[data-screens-bar]');
  if (track && prev && next && bar) {
    const step = () => (track.querySelector<HTMLElement>('.screen-card')?.offsetWidth ?? 320) + 20;
    const sync = () => {
      const max = track.scrollWidth - track.clientWidth;
      const at = max > 0 ? track.scrollLeft / max : 1;
      bar.style.setProperty('--at', String(at));
      bar.style.setProperty('--size', String(max > 0 ? track.clientWidth / track.scrollWidth : 1));
      prev.disabled = track.scrollLeft < 4;
      next.disabled = track.scrollLeft > max - 4;
    };
    const smooth = () => (window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth');
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: smooth() }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: smooth() }));
    track.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true });
    window.addEventListener('resize', sync, { passive: true });
    sync();
  }
</script>

<style>
