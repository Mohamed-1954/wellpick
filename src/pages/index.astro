    .chapter-title { font-size: 1.75rem; line-height: 1.1; max-width: none; }
  }
  .chapter-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 0.85rem; font-size: 0.9375rem; color: var(--on-chapter-muted); }
  .chapter-tool { padding-right: 0.85rem; border-right: 1px solid oklch(1 0 0 / 0.4); font-size: 1.125rem; font-weight: 700; color: var(--on-chapter); }
