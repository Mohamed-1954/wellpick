  .stage-blurb { color: var(--muted); margin-top: 0.3rem; }
  .stage-col ul { list-style: none; margin: var(--s-4) 0 0; padding: 0; display: grid; }
  .stage-col a {
    display: block;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
