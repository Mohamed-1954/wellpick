  }
  .rail-n { grid-area: n; align-self: start; padding-top: 0.2rem; font-size: 0.8125rem; font-weight: 620; color: var(--muted); }
  .rail-tab { grid-area: tab; align-self: end; font-size: 1.25rem; font-weight: 720; line-height: 1.15; letter-spacing: -0.015em; }
  .rail-tool { grid-area: tool; align-self: start; font-size: 0.875rem; font-weight: 560; color: var(--muted); }
  .rail-bar {
