  .screen-card { flex: 0 0 clamp(16.5rem, 13rem + 12vw, 23rem); scroll-snap-align: start; }
  .screen-card a { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.75rem; text-decoration: none; }
  .screen-media {
